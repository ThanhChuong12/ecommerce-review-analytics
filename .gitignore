# ===================================================
# .gitignore — Multimodal Review Analytics Dashboard
# ===================================================

# --- Secrets & Config ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
dist/

# --- Dữ liệu (không commit dữ liệu thô/lớn) ---
data/raw/*
!data/raw/.gitkeep
scraping_agent/output/*
scraping_agent/data/*
!scraping_agent/output/.gitkeep

# --- CSV data thô (scraped data) ---
data/*.csv

# --- Thư mục xử lý Media & Ảnh ---
image_labeling/new_data/
image_labeling/data/frames/
image_labeling/data/raw_media/
image_labeling/data/labeled/
image_labeling.zip
data.zip
data/processed/training_images.zip

# --- Labeled dataset (ảnh lớn, không commit) ---
labeled/

# --- Model weights (binary lớn) ---
*.pt
*.pth
*.bin
*.onnx

# --- Training artifacts (kết quả train, ảnh lớn) ---
ai_engine/models/results/*.png
ai_engine/models/results/*_error_analysis/
ai_engine/models/results/*_training_history.json
ai_engine/models/weights/cpu_run_v2/

# Giữ lại file results JSON nhỏ (summary metrics)
!ai_engine/models/results/image_baseline_results.json

# --- Thu muc test tam thoi ---
test_*/

# --- Scratch / one-off scripts (chi o root) ---
/test_*.py
/run_eval.py

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
.claude/


# Bỏ qua toàn bộ nội dung trong thư mục models và plots
artifacts/models/**/*
artifacts/plots/**/*

# NHƯNG giữ lại file .gitkeep để duy trì cấu trúc thư mục trên GitHub
!artifacts/models/**/.gitkeep
!artifacts/plots/**/.gitkeep

# --- Chặn file zip đóng gói Kaggle ---
resnet50_kaggle_train.zip
kaggle_dataset.zip