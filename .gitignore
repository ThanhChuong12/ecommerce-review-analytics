# ===================================================
# .gitignore — Multimodal Review Analytics Dashboard
# ===================================================

# --- Secrets & Config ---
.env
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Node.js ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.next/
dist/

# --- Dữ liệu (không commit dữ liệu thô/lớn) ---
data/raw/*
!data/raw/.gitkeep
scraping_agent/output/*
scraping_agent/data/*
!scraping_agent/output/.gitkeep

# Thư mục xử lý Media & Ảnh
image_labeling/new_data/
image_labeling/data/frames/
image_labeling/data/raw_media/
image_labeling/data/labeled/
image_labeling.zip
data.zip
data/processed/training_images.zip
# ai_engine/models/*.pth  ← tắt để push kết quả train
# Chặn theo định dạng

*.mp4
*.avi
*.jpg
*.jpeg
*.png


# --- Model weights (tắt để push kết quả train) ---
# ai_engine/models/weights/*.pt
# ai_engine/models/weights/*.pth
# ai_engine/models/weights/*.bin
# ai_engine/models/weights/*.onnx

# --- Labeled dataset (anh lon, khong commit) ---
labeled/

# --- Thu muc test tam thoi ---
test_*/

# --- Scratch / one-off scripts (chi o root) ---
/test_*.py
/run_eval.py

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
.claude/


# Bỏ qua toàn bộ nội dung trong thư mục models và plots
artifacts/models/**/*
artifacts/plots/**/*

# NHƯNG giữ lại file .gitkeep để duy trì cấu trúc thư mục trên GitHub
!artifacts/models/**/.gitkeep
!artifacts/plots/**/.gitkeep

# Chặn file zip đóng gói Kaggle
resnet50_kaggle_train.zip