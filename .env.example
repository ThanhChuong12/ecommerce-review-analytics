# ===================================================
# .env.example — Sao chép thành .env và điền API keys
# TUYỆT ĐỐI KHÔNG commit file .env lên GitHub!
# ===================================================

# --- Scraping Agent (LLM Agent cho Shopee, v.v.) ---
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=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
OPENAI_API_KEY=your_openai_api_key_here
BROWSER_USE_API_KEY=your_browseruse_api_key_here   # optional
PROJECT_ID=your_gcp_project_id_here

# --- Browser-Use Agent Settings ---
BROWSER_USE_LOGGING_LEVEL=warning   # debug | info | warning | error
ANONYMIZED_TELEMETRY=false

# --- Backend AI: LLM Integration ---
# LLM provider switch: gemini | openai | grok
LLM_PROVIDER=gemini

# Gemini (fallback sentiment)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (fallback sentiment)
OPENAI_MODEL=gpt-4o-mini

# Grok (xAI) uses OpenAI-compatible API
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2-latest

# --- Web App Backend Server ---
PORT=3001
PYTHON_AI_SERVICE_URL=http://localhost:8000

HF_TOKEN=your_huggingface_token_here